{
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tabulator-tables": "^6.5.2"
  },
  "description": "Static desktop workbench for reviewing completed liveness_primer JSON reports.",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/tabulator-tables": "^6.3.6",
    "ajv": "^8.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.0",
    "typescript": "^7.0.2"
  },
  "license": "Apache-2.0",
  "name": "liveness-primer-explorer",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/lib/**' --test-coverage-lines=100 --test-coverage-branches=96 --test-coverage-functions=100 tests/unit/*.test.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "generate-validators": "node generate-validators.mjs",
    "licenses": "node check-licenses.mjs",
    "lint": "eslint --max-warnings 0 .",
    "serve": "node tests/browser/serve.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "type": "module",
  "version": "0.0.1"
}
